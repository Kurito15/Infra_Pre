# Copy to .env for local development. Replace placeholders locally; never commit .env.local.
# Server-side only: do not prefix these with VITE_.
ROBOFLOW_API_KEY=replace-with-your-server-side-roboflow-api-key
ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/your-workspace/workflows/your-workflow
GEMINI_API_KEY=replace-with-your-server-side-gemini-api-key
TINYFISH_API_KEY=replace-with-your-server-side-tinyfish-api-key

# Public frontend config (protected by Supabase Auth and RLS; not a service-role key).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
